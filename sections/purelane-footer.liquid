<footer data-scene="4">
  <div class="wrap">
    <div class="fgrid">
      <div class="fcol">
        <a class="brand" href="{{ routes.root_url }}" style="margin-bottom:16px">
          <span class="mark">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color:#b8701c"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/><path d="M12 21v-6"/></svg>
          </span>
          <span class="txt"><span class="n1">PureLane</span><span class="n2">Clean, simply</span></span>
        </a>
        <p style="max-width:30ch">{{ section.settings.text }}</p>
      </div>
      
      {%- for block in section.blocks -%}
        <div class="fcol" {{ block.shopify_attributes }}>
          <h5>{{ block.settings.heading | default: block.settings.menu.title }}</h5>
          {%- if block.settings.menu != blank -%}
            {%- for link in block.settings.menu.links -%}
              <a href="{{ link.url }}">{{ link.title }}</a>
            {%- endfor -%}
          {%- else -%}
            <a href="/collections/all">Shop all</a>
            <a href="/pages/contact">Contact us</a>
          {%- endif -%}
        </div>
      {%- endfor -%}
      
      <div class="fcol">
        <h5>Get in touch</h5>
        <a href="mailto:{{ shop.email }}">{{ shop.email }}</a>
        <a href="tel:{{ shop.phone }}">{{ shop.phone }}</a>
        <p style="font-size:12px;color:rgba(236,230,247,.5)">PureLane</p>
      </div>
    </div>
    <div class="fbot">
      <span>&copy; {{ 'now' | date: "%Y" }} PureLane</span>
      <span>
        {%- for link in linklists.footer.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>{% unless forloop.last %} &middot; {% endunless %}
        {%- endfor -%}
      </span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Purelane Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "text",
      "label": "Brand Description",
      "default": "Effective cleaning, powered by nature. Made for Indian homes since day one."
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Quick links",
          "label": "Heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "default": "footer",
          "label": "Menu"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "link_list"
      },
      {
        "type": "link_list"
      }
    ]
  }
}
{% endschema %}
