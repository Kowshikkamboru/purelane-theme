<footer data-scene="4">
  <div class="wrap">
    <div class="fgrid">
      <div class="fcol">
        <a class="brand" href="{{ routes.root_url }}" style="margin-bottom:16px">
          <span class="mark">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color:#b8701c"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/><path d="M12 21v-6"/></svg>
          </span>
          <span class="txt"><span class="n1">PureLane</span><span class="n2">Clean, simply</span></span>
        </a>
        <p style="max-width:30ch">{{ section.settings.text }}</p>
      </div>
      
      <div class="fcol">
        <h5>SHOP</h5>
        <a href="{{ routes.root_url }}#shop">Bestsellers</a>
        <a href="/collections/kitchen">Kitchen</a>
        <a href="/collections/laundry">Laundry</a>
        <a href="/collections/home">Home</a>
        <a href="/collections/skin">Skin</a>
        <a href="{{ routes.root_url }}#bundles">Starter kits</a>
      </div>
      <div class="fcol">
        <h5>ABOUT</h5>
        <a href="{{ routes.root_url }}#ingredients">Ingredients</a>
        <a href="{{ routes.root_url }}#how-it-works">How it works</a>
        <a href="{{ routes.root_url }}#combos">Combos</a>

        <a href="/pages/faqs">FAQs</a>
        <a href="{{ routes.root_url }}#reviews">Reviews</a>
      </div>
      
      <div class="fcol">
        <h5>GET IN TOUCH</h5>
        <a href="mailto:hello@purelane.com">hello@purelane.com</a>
        <a href="tel:+919930123234">+91 9930 123 234</a>
        <p style="font-size:12px;color:rgba(236,230,247,.5)">Purelane Eco Products Pvt Ltd</p>
      </div>
    </div>
    <div class="fbot">
      <span>&copy; {{ 'now' | date: "%Y" }} Purelane Eco Products Private Limited</span>
      <span>
        <a href="/policies/privacy-policy">Privacy</a> &middot;
        <a href="/policies/terms-of-service">Terms</a> &middot;
        <a href="/policies/refund-policy">Refunds</a> &middot;
        <a href="/pages/contact">Contact</a>
      </span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Purelane Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "text",
      "label": "Brand Description",
      "default": "Effective cleaning, powered by nature. Made for Indian homes since day one."
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Quick links",
          "label": "Heading"
        },
        {
          "type": "link_list",
          "id": "menu",
          "default": "footer",
          "label": "Menu"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "link_list"
      },
      {
        "type": "link_list"
      }
    ]
  }
}
{% endschema %}
