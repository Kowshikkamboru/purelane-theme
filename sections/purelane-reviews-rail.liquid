<!-- ================= CUSTOMER REVIEWS (auto marquee) ================= -->
<section class="sec revband" id="reviews" data-scene="1">
  <div class="wrap">
    <div class="revhead rv">
      <span class="kicker">{{ section.settings.kicker }}</span>
      <span class="agg">
        <span class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</span> 
        <b>{{ section.settings.rating }}</b> from {{ section.settings.review_count }} reviews
      </span>
      <span class="agg">Loved by <b>{{ section.settings.homes_count }}</b> homes</span>
    </div>
  </div>
  <div class="revrail rv" aria-label="Customer reviews">
    <div class="revtrack">
      {%- for block in section.blocks -%}
        <article class="glass-2 rcard" {{ block.shopify_attributes }}>
          <div class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <h5>{{ block.settings.title }}</h5>
          <p>{{ block.settings.text }}</p>
          <div class="who">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
            <b>{{ block.settings.author }}</b>
            <span>&middot; {{ block.settings.product }}</span>
          </div>
        </article>
      {%- endfor -%}
      {%- comment -%}Duplicate for seamless loop if needed, or CSS handles it. The original HTML duplicated them.{%- endcomment -%}
      {%- for block in section.blocks -%}
        <article class="glass-2 rcard" aria-hidden="true">
          <div class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <h5>{{ block.settings.title }}</h5>
          <p>{{ block.settings.text }}</p>
          <div class="who">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
            <b>{{ block.settings.author }}</b>
            <span>&middot; {{ block.settings.product }}</span>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Reviews Rail",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "That's what they said"
    },
    {
      "type": "text",
      "id": "rating",
      "label": "Rating",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Review Count",
      "default": "8,000+"
    },
    {
      "type": "text",
      "id": "homes_count",
      "label": "Homes Count",
      "default": "12 lakh+"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Works like a charm"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Anita"
        },
        {
          "type": "text",
          "id": "product",
          "label": "Product Referenced",
          "default": "Laundry detergent"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Reviews Rail",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
