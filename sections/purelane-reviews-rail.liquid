<!-- ================= CUSTOMER REVIEWS (auto marquee) ================= -->
<section class="sec revband" id="reviews" data-scene="1">
  <div class="wrap">
    <div class="revhead rv">
      <span class="kicker">{{ section.settings.kicker }}</span>
      <span class="agg">
        <span class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</span> 
        <b>{{ section.settings.rating }}</b> from {{ section.settings.review_count }} reviews
      </span>
      <span class="agg">Loved by <b>{{ section.settings.homes_count }}</b> homes</span>
    </div>
  </div>
  <div class="revrail rv" aria-label="Customer reviews">
    <div class="revtrack" style="gap: 0;">
      {%- for i in (1..4) -%}
        <div class="rev-set" style="display: flex; gap: 12px; padding-right: 12px;" {% if forloop.index > 1 %}aria-hidden="true"{% endif %}>
          {%- for block in section.blocks -%}
            <article class="rcard" style="background: transparent; border: none; box-shadow: none;" {% if forloop.parentloop.index == 1 %}{{ block.shopify_attributes }}{% endif %}>
              <div class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
              <h5>{{ block.settings.title }}</h5>
              <p>{{ block.settings.text }}</p>
              <div class="who">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
                <b>{{ block.settings.author }}</b>
                {%- assign linked_product = block.settings.product -%}
                <span>&middot; {% if linked_product != blank %}{{ linked_product.title }}{% else %}{{ block.settings.product_text }}{% endif %}</span>
              </div>
            </article>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Reviews Rail",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "That's what they said"
    },
    {
      "type": "text",
      "id": "rating",
      "label": "Rating",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Review Count",
      "default": "8,000+"
    },
    {
      "type": "text",
      "id": "homes_count",
      "label": "Homes Count",
      "default": "12 lakh+"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Works like a charm"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Anita"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product Referenced"
        },
        {
          "type": "text",
          "id": "product_text",
          "label": "Product Text Fallback",
          "default": "Laundry detergent"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Reviews Rail",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
