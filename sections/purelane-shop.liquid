<!-- ================= SHOP ================= -->
<section class="sec" id="shop" data-scene="3">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      <div class="rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
    </div>
    <div class="shelf">
      {%- assign shop_collection = collections[section.settings.collection] -%}
      {%- if shop_collection != blank -%}
        {%- for product in shop_collection.products limit: section.settings.products_to_show -%}
          {%- assign mod = forloop.index0 | modulo: 4 -%}
          {%- assign delay_class = '' -%}
          {%- if mod == 1 -%}{%- assign delay_class = 'rv-d1' -%}
          {%- elsif mod == 2 -%}{%- assign delay_class = 'rv-d2' -%}
          {%- elsif mod == 3 -%}{%- assign delay_class = 'rv-d3' -%}
          {%- endif -%}
          {% render 'purelane-product-card', product: product, custom_class: delay_class %}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%}Placeholder content{%- endcomment -%}
        {%- for i in (1..4) -%}
          {%- assign mod = forloop.index0 | modulo: 4 -%}
          {%- assign delay_class = '' -%}
          {%- if mod == 1 -%}{%- assign delay_class = 'rv-d1' -%}
          {%- elsif mod == 2 -%}{%- assign delay_class = 'rv-d2' -%}
          {%- elsif mod == 3 -%}{%- assign delay_class = 'rv-d3' -%}
          {%- endif -%}
          {%- assign placeholder = 'product-' | append: i -%}
          {% render 'purelane-product-card', product: null, fallback_image: placeholder, custom_class: delay_class %}
        {%- endfor -%}
      {%- endif -%}
    </div>
    {%- if shop_collection != blank -%}
      <div style="text-align: center; margin-top: 40px;" class="rv rv-d3">
        <a href="/collections/all" class="btn btn-primary" style="padding: 14px 32px; font-size: 14px; text-decoration: none;">View all products</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Purelane Shop",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 4,
      "default": 4,
      "label": "Products to show"
    }
  ],
  "presets": [
    {
      "name": "Purelane Shop"
    }
  ]
}
{% endschema %}
