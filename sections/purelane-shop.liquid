<!-- ================= SHOP ================= -->
<section class="sec" id="shop" data-scene="3">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      <div class="rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
    </div>
    <div class="shelf">
      {%- assign shop_collection = collections[section.settings.collection] -%}
      {%- if shop_collection != blank -%}
        {%- for product in shop_collection.products limit: section.settings.products_to_show -%}
          <article class="glass card rv">
            <div class="shot">
              {%- if product.metafields.custom.badge != blank -%}
                <span class="pill">{{ product.metafields.custom.badge }}</span>
              {%- endif -%}
              {%- if product.featured_image != blank -%}
                {{ product.featured_image | image_url: width: 300 | image_tag: class: 'pimg', loading: 'lazy' }}
              {%- else -%}
                <span class="pimg p-tap" role="img"></span> {%- comment -%}Fallback CSS image{%- endcomment -%}
              {%- endif -%}
            </div>
            <h4>{{ product.title }}</h4>
            <div class="rate">
              <b>★ {{ product.metafields.reviews.rating.value | default: '4.8' }}</b> · {{ product.metafields.reviews.rating_count | default: '230' }} reviews
            </div>
            <div class="pr">
              <strong>{{ product.price | money }}</strong>
              {%- if product.compare_at_price > product.price -%}
                <s>{{ product.compare_at_price | money }}</s>
                {%- assign savings = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
                <em>{{ savings }}% off</em>
              {%- endif -%}
            </div>
            {%- form 'product', product -%}
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              <button type="submit" class="btn btn-ghost btn-sm" {% unless product.available %}disabled{% endunless %}>
                {% if product.available %}Add to cart{% else %}Sold out{% endif %}
              </button>
            {%- endform -%}
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%}Placeholder content{%- endcomment -%}
        {%- for i in (1..4) -%}
          <article class="glass card rv">
            <div class="shot">
              <span class="pill">Best seller</span>
              <span class="pimg p-kitchen" role="img"></span>
            </div>
            <h4>Kitchen cleaner, foaming</h4>
            <div class="rate"><b>★ 4.8</b> · 254 reviews</div>
            <div class="pr"><strong>₹200</strong><s>₹299</s><em>33% off</em></div>
            <button class="btn btn-ghost btn-sm">Add to cart</button>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Shop",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 4,
      "default": 4,
      "label": "Products to show"
    }
  ],
  "presets": [
    {
      "name": "Purelane Shop"
    }
  ]
}
{% endschema %}
