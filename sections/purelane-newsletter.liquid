<!-- ================= SIGNUP ================= -->
<section class="sec" data-scene="4">
  <div class="wrap">
    <div class="glass signup rv">
      <span class="kicker">Join the Purelane Club</span>
      <h2 class="d2" style="margin-top:12px">Get ₹100 off your first bundle</h2>
      <p class="lede" style="margin:0 auto">Plus first access to new launches and restocks.</p>
      {% form 'customer' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div style="display: flex; gap: 10px; max-width: 480px; margin: 0 auto;">
          <input type="email" name="contact[email]" placeholder="your@email.com" aria-label="Email address" required style="flex: 1; min-width: 180px; height: 46px; padding: 0 18px; border-radius: 999px; font-size: 14px; font-family: inherit; color: var(--surface); border: none; outline: none; box-shadow: inset 0 0 0 1px rgba(0,0,0,0.1);">
          <button class="btn btn-primary" type="submit">Get my ₹100 off</button>
        </div>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Newsletter",
  "settings": [],
  "presets": [
    {
      "name": "Purelane Newsletter"
    }
  ]
}
{% endschema %}
