<!-- ================= BUNDLES ================= -->
<section class="sec" id="bundles-{{ section.id }}" data-scene="3">
  <div class="wrap">
    <div class="glass sec-pad rv" style="margin-bottom:16px">
      <div class="panel-head" style="margin-bottom:0">
        <span class="kicker">{{ section.settings.kicker }}</span>
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
        <p class="lede" style="margin:0 auto">{{ section.settings.text }}</p>
      </div>
    </div>
    <div class="tiers">
      {%- for block in section.blocks -%}
        <article class="glass tier{% if block.settings.is_best %} best{% endif %} rv" {{ block.shopify_attributes }}>
          <span class="tag">{{ block.settings.tag }}</span>
          <div class="tierpix{% if block.settings.is_five %} five{% endif %}" aria-hidden="true">
            {%- assign p1 = block.settings.item_1 -%}
            {%- assign p2 = block.settings.item_2 -%}
            {%- assign p3 = block.settings.item_3 -%}
            {%- assign p4 = block.settings.item_4 -%}
            {%- assign p5 = block.settings.item_5 -%}
            
            {%- if p1 != blank -%}
              <span class="pimg" role="img" aria-label="{{ p1.title | escape }}" style="background-image: url('{{ p1.featured_image | image_url: width: 200 }}'); background-size: contain; background-repeat: no-repeat; background-position: center bottom;"></span>
            {%- elsif block.settings.product_1_img != blank -%}
              <span class="pimg {{ block.settings.product_1_img }}" role="img"></span>
            {%- endif -%}
            
            {%- if p2 != blank -%}
              <span class="pimg" role="img" aria-label="{{ p2.title | escape }}" style="background-image: url('{{ p2.featured_image | image_url: width: 200 }}'); background-size: contain; background-repeat: no-repeat; background-position: center bottom;"></span>
            {%- elsif block.settings.product_2_img != blank -%}
              <span class="pimg {{ block.settings.product_2_img }}" role="img"></span>
            {%- endif -%}
            
            {%- if p3 != blank -%}
              <span class="pimg" role="img" aria-label="{{ p3.title | escape }}" style="background-image: url('{{ p3.featured_image | image_url: width: 200 }}'); background-size: contain; background-repeat: no-repeat; background-position: center bottom;"></span>
            {%- elsif block.settings.product_3_img != blank -%}
              <span class="pimg {{ block.settings.product_3_img }}" role="img"></span>
            {%- endif -%}
            
            {%- if p4 != blank -%}
              <span class="pimg" role="img" aria-label="{{ p4.title | escape }}" style="background-image: url('{{ p4.featured_image | image_url: width: 200 }}'); background-size: contain; background-repeat: no-repeat; background-position: center bottom;"></span>
            {%- elsif block.settings.product_4_img != blank -%}
              <span class="pimg {{ block.settings.product_4_img }}" role="img"></span>
            {%- endif -%}
            
            {%- if p5 != blank -%}
              <span class="pimg" role="img" aria-label="{{ p5.title | escape }}" style="background-image: url('{{ p5.featured_image | image_url: width: 200 }}'); background-size: contain; background-repeat: no-repeat; background-position: center bottom;"></span>
            {%- elsif block.settings.product_5_img != blank -%}
              <span class="pimg {{ block.settings.product_5_img }}" role="img"></span>
            {%- endif -%}
          </div>
          <div class="qty">{{ block.settings.qty }}<small>Products</small></div>
          
          {%- assign main_product = block.settings.product_main -%}
          <div class="price">
            {%- if main_product != blank -%}
              {{ main_product.price | money }} 
              {%- if main_product.compare_at_price > main_product.price -%}
                <s>{{ main_product.compare_at_price | money }}</s>
              {%- endif -%}
            {%- else -%}
              {{ block.settings.price }} <s>{{ block.settings.compare_price }}</s>
            {%- endif -%}
          </div>
          
          <p class="body-s" style="font-size:12px">{{ block.settings.per_product_text }}</p>
          <ul>
            {%- if block.settings.feature_1 != blank -%}
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.feature_1 }}</li>
            {%- endif -%}
            {%- if block.settings.feature_2 != blank -%}
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.feature_2 }}</li>
            {%- endif -%}
            {%- if block.settings.feature_3 != blank -%}
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.feature_3 }}</li>
            {%- endif -%}
          </ul>
          {%- assign btn_link = main_product.url | default: block.settings.link -%}
          <a class="btn {% if block.settings.is_best %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ btn_link | default: '#' }}">
            {{ block.settings.button_text }}
            {%- if block.settings.is_best -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
            {%- endif -%}
          </a>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Bundles",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Build your bundle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One box. Every room."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way."
    }
  ],
  "blocks": [
    {
      "type": "bundle",
      "name": "Bundle",
      "settings": [
        {
          "type": "checkbox",
          "id": "is_best",
          "label": "Highlight as Best Bundle",
          "default": false
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag (e.g. Starter)",
          "default": "Starter"
        },
        {
          "type": "checkbox",
          "id": "is_five",
          "label": "Is 5-product Layout?",
          "default": false
        },
        {
          "type": "text",
          "id": "qty",
          "label": "Quantity",
          "default": "2"
        },
        {
          "type": "product",
          "id": "product_main",
          "label": "Main Bundle Product (for price)"
        },
        {
          "type": "text",
          "id": "per_product_text",
          "label": "Per Product Text",
          "default": "Flat ₹174 per product"
        },
        {
          "type": "text",
          "id": "feature_1",
          "label": "Feature 1",
          "default": "Pick any two products"
        },
        {
          "type": "text",
          "id": "feature_2",
          "label": "Feature 2",
          "default": "Free shipping across India"
        },
        {
          "type": "text",
          "id": "feature_3",
          "label": "Feature 3"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Build this box"
        },
        {
          "type": "header",
          "content": "Images"
        },
        {
          "type": "product",
          "id": "item_1",
          "label": "Item 1 Product"
        },
        {
          "type": "text",
          "id": "product_1_img",
          "label": "Item 1 Image Class Fallback"
        },
        {
          "type": "product",
          "id": "item_2",
          "label": "Item 2 Product"
        },
        {
          "type": "text",
          "id": "product_2_img",
          "label": "Item 2 Image Class Fallback"
        },
        {
          "type": "product",
          "id": "item_3",
          "label": "Item 3 Product"
        },
        {
          "type": "text",
          "id": "product_3_img",
          "label": "Item 3 Image Class Fallback"
        },
        {
          "type": "product",
          "id": "item_4",
          "label": "Item 4 Product"
        },
        {
          "type": "text",
          "id": "product_4_img",
          "label": "Item 4 Image Class Fallback"
        },
        {
          "type": "product",
          "id": "item_5",
          "label": "Item 5 Product"
        },
        {
          "type": "text",
          "id": "product_5_img",
          "label": "Item 5 Image Class Fallback"
        },
        {
          "type": "header",
          "content": "Fallback Overrides (if main product not selected)"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "₹349"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare Price",
          "default": "₹598"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link Fallback"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Bundles"
    }
  ]
}
{% endschema %}
