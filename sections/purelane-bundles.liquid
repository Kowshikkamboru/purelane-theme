<!-- ================= BUNDLES ================= -->
<section class="sec" id="bundles" data-scene="3">
  <div class="wrap">
    <div class="glass sec-pad rv" style="margin-bottom:16px">
      <div class="panel-head" style="margin-bottom:0">
        <span class="kicker">{{ section.settings.kicker }}</span>
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
        <p class="lede" style="margin:0 auto">{{ section.settings.text }}</p>
      </div>
    </div>
    <div class="tiers">
      {%- for block in section.blocks -%}
        <article class="glass tier{% if block.settings.is_best %} best{% endif %} rv" {{ block.shopify_attributes }}>
          <span class="tag">{{ block.settings.tag }}</span>
          <div class="tierpix{% if block.settings.is_five %} five{% endif %}" aria-hidden="true">
            {%- if block.settings.product_1_img != blank -%}
              <span class="pimg {{ block.settings.product_1_img }}" role="img"></span>
            {%- endif -%}
            {%- if block.settings.product_2_img != blank -%}
              <span class="pimg {{ block.settings.product_2_img }}" role="img"></span>
            {%- endif -%}
            {%- if block.settings.product_3_img != blank -%}
              <span class="pimg {{ block.settings.product_3_img }}" role="img"></span>
            {%- endif -%}
            {%- if block.settings.product_4_img != blank -%}
              <span class="pimg {{ block.settings.product_4_img }}" role="img"></span>
            {%- endif -%}
            {%- if block.settings.product_5_img != blank -%}
              <span class="pimg {{ block.settings.product_5_img }}" role="img"></span>
            {%- endif -%}
          </div>
          <div class="qty">{{ block.settings.qty }}<small>Products</small></div>
          <div class="price">{{ block.settings.price }} <s>{{ block.settings.compare_price }}</s></div>
          <p class="body-s" style="font-size:12px">{{ block.settings.per_product_text }}</p>
          <ul>
            {%- if block.settings.feature_1 != blank -%}
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.feature_1 }}</li>
            {%- endif -%}
            {%- if block.settings.feature_2 != blank -%}
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.feature_2 }}</li>
            {%- endif -%}
            {%- if block.settings.feature_3 != blank -%}
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.feature_3 }}</li>
            {%- endif -%}
          </ul>
          <a class="btn {% if block.settings.is_best %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ block.settings.link }}">
            {{ block.settings.button_text }}
            {%- if block.settings.is_best -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
            {%- endif -%}
          </a>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Bundles",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Build your bundle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One box. Every room."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way."
    }
  ],
  "blocks": [
    {
      "type": "bundle",
      "name": "Bundle",
      "settings": [
        {
          "type": "checkbox",
          "id": "is_best",
          "label": "Highlight as Best Bundle",
          "default": false
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag (e.g. Starter)",
          "default": "Starter"
        },
        {
          "type": "checkbox",
          "id": "is_five",
          "label": "Is 5-product Layout?",
          "default": false
        },
        {
          "type": "text",
          "id": "qty",
          "label": "Quantity",
          "default": "2"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "₹349"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare Price",
          "default": "₹598"
        },
        {
          "type": "text",
          "id": "per_product_text",
          "label": "Per Product Text",
          "default": "Flat ₹174 per product"
        },
        {
          "type": "text",
          "id": "feature_1",
          "label": "Feature 1",
          "default": "Pick any two products"
        },
        {
          "type": "text",
          "id": "feature_2",
          "label": "Feature 2",
          "default": "Free shipping across India"
        },
        {
          "type": "text",
          "id": "feature_3",
          "label": "Feature 3"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Build this box"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "header",
          "content": "Images (CSS Classes)"
        },
        {
          "type": "text",
          "id": "product_1_img",
          "label": "Product 1 Image Class (e.g. p-combo2)"
        },
        {
          "type": "text",
          "id": "product_2_img",
          "label": "Product 2 Image Class"
        },
        {
          "type": "text",
          "id": "product_3_img",
          "label": "Product 3 Image Class"
        },
        {
          "type": "text",
          "id": "product_4_img",
          "label": "Product 4 Image Class"
        },
        {
          "type": "text",
          "id": "product_5_img",
          "label": "Product 5 Image Class"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Bundles"
    }
  ]
}
{% endschema %}
